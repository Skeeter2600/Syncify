JELLYFIN_URL=http://1.2.3.4:5678/
JELLYFIN_API_KEY=123456789

# Path to your music library — mounted into the container via docker-compose
MUSIC_LIBRARY_PATH="C:\Users\You\Desktop\temp"

DEEZER_ARL="123456789"
SERVICE_BASE_URL=https://url.com
SECRET_KEY=123456789

# SQLite database location (relative to container workdir)
DATABASE_URL=sqlite:///data/playlist_service.db

# Folder for persistent SQLite file — configurable for any mount point
DATA_DIR=data

# Logging verbosity: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
